              "path": [
                "api",
                "tickets",
                "{{ticketId}}",
                "assign"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assigneeId\": \"{{userId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send {\"assigneeId\": null} to unassign."
          }
        }
      ]
    },
