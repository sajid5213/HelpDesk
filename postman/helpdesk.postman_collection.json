    {
      "name": "6 Agent session",
      "description": "Log in as the agent created in '2 Users'. Requests now run as the agent.",
      "item": [
        {
          "name": "Login (agent)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "token"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{agentEmail}}\",\n  \"password\": \"{{agentPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Create the agent first with '2 Users / Create agent' (as admin)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get my assigned ticket",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tickets/{{ticketId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "tickets",
                "{{ticketId}}"
              ]
            },
            "description": "Works because '3 Tickets / Assign (admin)' gave this ticket to the agent."
          }
        },
