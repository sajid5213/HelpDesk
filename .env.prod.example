# Copy to .env.prod (gitignored) and fill in real values. Never commit the copy.

# Host port for the app (8080 by default)
HELPDESK_HTTP_PORT=8080

# Database password, shared by Postgres and the app
DB_PASSWORD=change-me

# Key that encrypts the JWT signing keys: openssl rand -base64 32
HELPDESK_KEK=

# First admin, created on first start (password >= 12 characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# AI: off, or api with an Anthropic API key (billed per use)
HELPDESK_AI_MODE=off
ANTHROPIC_API_KEY=

# Email: smtp sends to the Mailpit container (inbox http://localhost:8026), log only logs
HELPDESK_EMAIL_MODE=smtp

# Observability (compose.observability.yaml): send traces to Tempo, and Grafana's admin password
TRACING_EXPORT_ENABLED=false
GRAFANA_ADMIN_PASSWORD=
