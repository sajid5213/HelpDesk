# Copy to backend/.env (gitignored) and fill in real values.
# Generate a key-encryption key with:  openssl rand -base64 32
HELPDESK_KEK=REPLACE_WITH_BASE64_32_BYTES
ADMIN_EMAIL=admin@helpdesk.local
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD
# Optional: turns on AI classification, summaries, and replies. Without it, tickets are handled by agents only.
ANTHROPIC_API_KEY=
# Or, with no API key: run the AI through the Claude Code CLI on your own Claude subscription (local only).
# HELPDESK_AI_MODE=claude-code
