    {
      "type": "bargauge",
      "title": "AI outcomes (24 h)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 4,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (outcome) (increase(helpdesk_ai_outcomes_total{env=~\"$env\"}[24h])))",
          "legendFormat": "{{outcome}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "auto_resolved: answered by the AI alone. suggested: draft left for an agent. failed: gave up after retries. skipped: AI off or Claude declined."
    },
    {
      "type": "timeseries",
      "title": "Claude call latency",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 7,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, operation) (rate(helpdesk_ai_call_seconds_bucket{env=~\"$env\"}[5m])))",
          "legendFormat": "p50 {{operation}}",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(helpdesk_ai_call_seconds_bucket{env=~\"$env\"}[5m])))",
          "legendFormat": "p95 {{operation}}",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "s",
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
            }
