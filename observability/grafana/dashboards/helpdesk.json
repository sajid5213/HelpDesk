          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (type) (increase(helpdesk_auth_events_total{type=~\"TOKEN_REFRESH|LOGOUT\",env=~\"$env\"}[5m]))",
          "legendFormat": "{{type}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "custom": {
            "fillOpacity": 12,
            "lineWidth": 2,
            "stacking": {
              "mode": "none"
